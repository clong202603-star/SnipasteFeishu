# Copy to .env and fill in. Do not commit the filled file.

# Vision model
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4.6v

# Feishu application credentials. Keep the base app_token and table_id on the local machine.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Contributor roster. On GitHub, store these as Actions secrets, not in the repository.
# DOUYIN_SEC_UID is the MS4wLjAB segment of the profile URL.
# When both are set, DOUYIN_SEC_UID is used.
DOUYIN_COOKIE=
DOUYIN_SEC_UID=
DOUYIN_UNIQUE_ID=
# Maximum people written in one day. Default 2000.
DOUYIN_FOLLOWER_LIMIT=2000
