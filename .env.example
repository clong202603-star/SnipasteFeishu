# 复制为 .env 后填写。不要把填好的文件提交到 GitHub。

# 智谱看图
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4.6v

# 飞书应用凭证。多维表格的 app_token、table_id 留在本机配置，不写进仓库。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 每日粉丝清单。GitHub 上请放到仓库 Settings → Secrets，不要写进代码。
# DOUYIN_SEC_UID 是个人主页网址里 MS4wLjAB 开头的那段。
# 两个都填时优先用 DOUYIN_SEC_UID。
DOUYIN_COOKIE=
DOUYIN_SEC_UID=
DOUYIN_UNIQUE_ID=
# 单日最多写入多少人，避免仓库被头像撑满。默认 2000。
DOUYIN_FOLLOWER_LIMIT=2000
